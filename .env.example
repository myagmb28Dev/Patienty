# ==============================================================================
# Patienty Environment Variables Configuration
# ==============================================================================

# [Database Configuration]
# Local Docker & Spring Boot datasource settings
POSTGRES_DB=patienty
POSTGRES_USER=patienty
POSTGRES_PASSWORD=patienty
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/patienty
# For Render / Production deployments, specify the PostgreSQL connection:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<render-postgres-host>:5432/patienty
# SPRING_DATASOURCE_USERNAME=<db-user>
# SPRING_DATASOURCE_PASSWORD=<db-password>

# [AI Provider & OpenRouter]
# OpenRouter API Key for AI Assistant (clinical context copilot)
OPENROUTER_API_KEY=your_openrouter_api_key_here
PATIENTY_AI_PROVIDER=openrouter
PATIENTY_AI_OPENROUTER_MODEL=google/gemini-2.0-flash-001

# [CORS & Security Settings]
# Comma-separated allowed frontend origins for CORS
PATIENTY_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://patienty-frontend.onrender.com
PATIENTY_SESSION_COOKIE_SECURE=false
PATIENTY_SESSION_COOKIE_SAME_SITE=lax

# [Frontend Client Settings]
# Base URL pointing to the backend API service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
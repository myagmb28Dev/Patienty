# Patienty environment template
#
# Local development:
#   Copy this file to .env.local and keep the values in the LOCAL section.
# Deployment:
#   Store the DEPLOYMENT replacements in your hosting provider's secret settings,
#   or copy them to an untracked .env file on a self-hosted server.
# Never commit .env or .env.local.

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT VALUES
# -----------------------------------------------------------------------------

# Docker Compose PostgreSQL
POSTGRES_DB=patienty
POSTGRES_USER=patienty
POSTGRES_PASSWORD=patienty
POSTGRES_PORT=5432

# Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/patienty
SPRING_DATASOURCE_USERNAME=patienty
SPRING_DATASOURCE_PASSWORD=patienty
PATIENTY_CORS_ALLOWED_ORIGINS=http://localhost:3000
PATIENTY_AI_PROVIDER=rule-based
PATIENTY_SESSION_COOKIE_SECURE=false
PATIENTY_SESSION_COOKIE_SAME_SITE=lax

# Next.js
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# DEPLOYMENT REPLACEMENTS (examples only; do not uncomment real secrets here)
# -----------------------------------------------------------------------------

# Activate prod or prod,demo with a CLI argument or hosting setting before this
# file is imported. Do not place SPRING_PROFILES_ACTIVE inside .env.
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-role>
# SPRING_DATASOURCE_PASSWORD=<neon-password>
# PATIENTY_CORS_ALLOWED_ORIGINS=https://<frontend-domain>
# PATIENTY_AI_PROVIDER=rule-based
# PATIENTY_SESSION_COOKIE_SECURE=true
# PATIENTY_SESSION_COOKIE_SAME_SITE=none
# NEXT_PUBLIC_API_BASE_URL=https://<backend-domain>
